{
	"name": "@langflower/shared",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/constants/defaults.js",
	"types": "./dist/constants/defaults.d.ts",
	"exports": {
		".": {
			"types": "./dist/constants/defaults.d.ts",
			"import": "./dist/constants/defaults.js"
		},
		"./constants/defaults": {
			"types": "./dist/constants/defaults.d.ts",
			"import": "./dist/constants/defaults.js"
		},
		"./constants/defaults.js": {
			"types": "./dist/constants/defaults.d.ts",
			"import": "./dist/constants/defaults.js"
		},
		"./types/config": {
			"types": "./dist/types/config.d.ts",
			"import": "./dist/types/config.js"
		},
		"./types/config.js": {
			"types": "./dist/types/config.d.ts",
			"import": "./dist/types/config.js"
		},
		"./langflower-bus-config": {
			"types": "./dist/langflower-bus-config.d.ts",
			"import": "./dist/langflower-bus-config.js"
		},
		"./langflower-bus-config.js": {
			"types": "./dist/langflower-bus-config.d.ts",
			"import": "./dist/langflower-bus-config.js"
		},
		"./langflower-ws-waits": {
			"types": "./dist/langflower-ws-waits.d.ts",
			"import": "./dist/langflower-ws-waits.js"
		},
		"./langflower-ws-waits.js": {
			"types": "./dist/langflower-ws-waits.d.ts",
			"import": "./dist/langflower-ws-waits.js"
		},
		"./langflower-config/*": {
			"types": "./dist/langflower-config/*.d.ts",
			"import": "./dist/langflower-config/*.js"
		},
		"./langflower-config/*.js": {
			"types": "./dist/langflower-config/*.d.ts",
			"import": "./dist/langflower-config/*.js"
		},
		"./checkpoint/*": {
			"types": "./dist/checkpoint/*.d.ts",
			"import": "./dist/checkpoint/*.js"
		},
		"./checkpoint/*.js": {
			"types": "./dist/checkpoint/*.d.ts",
			"import": "./dist/checkpoint/*.js"
		},
		"./execution/*": {
			"types": "./dist/execution/*.d.ts",
			"import": "./dist/execution/*.js"
		},
		"./execution/*.js": {
			"types": "./dist/execution/*.d.ts",
			"import": "./dist/execution/*.js"
		},
		"./types/*": {
			"types": "./dist/types/*.d.ts",
			"import": "./dist/types/*.js"
		},
		"./types/*.js": {
			"types": "./dist/types/*.d.ts",
			"import": "./dist/types/*.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@langflower/node-sdk": "0.1.0",
		"@langflower/runtime": "0.1.0",
		"@langflower/websocket-bridge": "0.1.0",
		"rxjs": "^7.8.1"
	},
	"files": [
		"dist"
	]
}
