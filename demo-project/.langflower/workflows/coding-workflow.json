{
	"$schema": "../schemas/workflow.schema.json",
	"metadata": {
		"name": "Coding workflow",
		"description": "Goal → Planner ⇄ Red Team → Approve plan → Coder ⇄ QA → Code review → Result review → Finish. Each accept output has one consumer.",
		"createdAt": "2026-09-20T19:05:00.000Z",
		"updatedAt": "2026-09-28T19:49:10.975Z"
	},
	"graph": {
		"viewport": {
			"x": -112.49553790332622,
			"y": 172.65685698143756,
			"scale": 0.6190298455000002,
			"width": 1191.203125,
			"height": 613.328125
		},
		"nodes": [
			{
				"id": "goal",
				"type": "common-chat-input",
				"params": {},
				"inputs": {
					"message": "Read and implement spec.md"
				},
				"ui": {
					"position": {
						"x": 220,
						"y": -80
					},
					"label": "Goal"
				}
			},
			{
				"id": "planner",
				"type": "common-openai-llm",
				"params": {
					"rolePreset": "plan",
					"includeAgentsMd": false,
					"maxIterations": 8,
					"maxFeedbackTurns": 4
				},
				"inputs": {
					"systemPrompt": "You are the Planner for a coding change.\nExplore the repo with harness tools (read/glob/grep).\nEmit a concise draft plan on response for red-team critique.\nWhen feedback arrives from Red Team or the plan gate, revise the plan — do not ignore it.\nDo not implement the change."
				},
				"ui": {
					"position": {
						"x": 440,
						"y": 120
					},
					"label": "Planner"
				}
			},
			{
				"id": "red-team",
				"type": "common-critique",
				"params": {
					"maxIterations": 6
				},
				"inputs": {
					"systemPrompt": "You are an independent red-team — not the Planner's co-author.\nAttack scope, missing tests, unsafe assumptions, and overclaim.\nCall feedback with 2–4 specific findings when the plan is not ready.\nCall accept only when further attack is non-blocking."
				},
				"ui": {
					"position": {
						"x": 700,
						"y": 40
					},
					"label": "Red Team"
				}
			},
			{
				"id": "plan-gate",
				"type": "common-hitl-review-gate",
				"params": {},
				"inputs": {},
				"ui": {
					"position": {
						"x": 980,
						"y": 500
					},
					"label": "Approve plan"
				}
			},
			{
				"id": "coder",
				"type": "common-openai-llm",
				"params": {
					"rolePreset": "coder",
					"includeAgentsMd": false,
					"maxIterations": 10,
					"maxFeedbackTurns": 4
				},
				"inputs": {
					"systemPrompt": "You receive an accepted plan. Implement with harness tools. Prefer minimal edits.\nWhen QA, Code review, or Result review send feedback, revise — do not ignore it."
				},
				"ui": {
					"position": {
						"x": 1180,
						"y": 80
					},
					"label": "Coder"
				}
			},
			{
				"id": "qa",
				"type": "common-review",
				"params": {
					"maxIterations": 6
				},
				"inputs": {
					"task": "Tests must pass.",
					"systemPrompt": "You are QA after the coder.\nAccept only if the result shows the tests pass.\nCall feedback with the failures otherwise. Do not implement the change."
				},
				"ui": {
					"position": {
						"x": 1440,
						"y": 40
					},
					"label": "QA"
				}
			},
			{
				"id": "review",
				"type": "common-review",
				"params": {
					"maxIterations": 5
				},
				"inputs": {
					"task": "The change matches the goal and the plan the coder was given.",
					"systemPrompt": "You are plan-fit review after QA accepted.\nCall accept only if the change matches that plan and is non-blocking.\nCall feedback with concrete revision notes otherwise. Do not implement."
				},
				"ui": {
					"position": {
						"x": 1700,
						"y": 40
					},
					"label": "Code review"
				}
			},
			{
				"id": "result-gate",
				"type": "common-hitl-review-gate",
				"params": {},
				"inputs": {},
				"ui": {
					"position": {
						"x": 1940,
						"y": 500
					},
					"label": "Result review"
				}
			},
			{
				"id": "done",
				"type": "common-finish",
				"params": {},
				"inputs": {},
				"ui": {
					"position": {
						"x": 2160,
						"y": 500
					},
					"label": "Finish"
				}
			}
		],
		"edges": [
