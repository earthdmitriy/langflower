			"height": 1005.328125
		},
		"nodes": [
			{
				"id": "goal",
				"type": "common-chat-input",
				"params": {},
				"inputs": {
					"message": "Draft a short plan to add a dark-mode toggle."
				},
				"ui": {
					"position": {
						"x": -80,
						"y": 400
					},
					"label": "Goal"
				}
			},
			{
				"id": "planner",
				"type": "common-openai-llm",
				"params": {
					"rolePreset": "plan",
					"includeAgentsMd": false,
					"maxIterations": 8,
					"maxFeedbackTurns": 4
				},
				"inputs": {
					"systemPrompt": "You are the Planner.\nWrite a concise implementation plan for the user's goal.\nWhen feedback arrives from Red Team or the approval gate, revise the plan — do not ignore it.\nDo not implement the change."
				},
				"ui": {
					"position": {
						"x": 220,
						"y": 240
					},
					"label": "Planner"
				}
			},
			{
				"id": "red-team",
				"type": "common-critique",
				"params": {
					"maxIterations": 6
				},
				"inputs": {
					"systemPrompt": "You are an independent red-team — not the Planner's co-author.\nAttack scope, missing tests, unsafe assumptions, and overclaim.\nCall feedback with 2–4 specific findings when the plan is not ready.\nCall accept only when further attack is non-blocking."
				},
				"ui": {
					"position": {
						"x": 620,
						"y": 40
					},
					"label": "Red Team"
				}
			},
			{
				"id": "plan-review",
				"type": "common-hitl-review-gate",
				"params": {},
				"inputs": {},
				"ui": {
					"position": {
						"x": 620,
						"y": 780
					},
					"label": "Approve plan"
				}
			},
			{
				"id": "done",
				"type": "common-finish",
				"params": {},
				"inputs": {},
				"ui": {
					"position": {
						"x": 940,
						"y": 800
					},
					"label": "Finish"
				}
			}
		],
