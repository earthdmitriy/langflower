{
	"mcpServers": {
		"ng-diagram-docs": {
			"command": "cmd",
			"args": ["/c", "npx", "-y", "@ng-diagram/mcp"],
			"type": "stdio"
		},
		"ts-scan": {
			"command": "cmd",
			"args": ["/c", "ts-scan", "--mcp"],
			"type": "stdio"
		},
		"langflower-kb": {
			"command": "node",
			"args": ["build/tools/kb-mcp.mjs"],
			"env": {
				"KB_EMBED_BASE_URL": "http://localhost:1234/v1",
				"KB_EMBED_MODEL": "text-embedding-bge-m3",
				"KB_EMBED_API_KEY": "${KB_EMBED_API_KEY:-}"
			},
			"type": "stdio"
		},
		"langflower": {
			"command": "cmd",
			"args": [
				"/c",
				"node",
				"packages/langflower-mcp/bin/langflower-mcp.js"
			],
			"type": "stdio"
		}
	}
}
